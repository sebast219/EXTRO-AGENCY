{"nodes": [{"id": "docs_02_spatial_design_language_depth_principle", "label": "Principle 01 \u2014 Depth is Mandatory", "file_type": "rationale", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El espacio nunca es plano; toda superficie posee profundidad expresada via sombra, no via outline."}, {"id": "docs_02_spatial_design_language_one_camera_principle", "label": "Principle 02 \u2014 One Space, One Camera", "file_type": "rationale", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Todos los elementos pertenecen al mismo espacio y responden a la misma camara y fisica; nada puede sobrepasar el sistema de camara."}, {"id": "docs_02_spatial_design_language_light_hierarchy", "label": "Principle 03 \u2014 Light Defines Hierarchy", "file_type": "rationale", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La jerarquia de contenido se expresa mediante iluminacion, nunca color; el color es funcional (CTA, status), nunca decorativo."}, {"id": "docs_02_spatial_design_language_motion_from_space", "label": "Principle 04 \u2014 Motion Emerges From Space", "file_type": "rationale", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Todo parametro de movimiento deriva de una propiedad espacial (profundidad, masa, posicion); si no tiene razon espacial, no se mueve."}, {"id": "docs_02_spatial_design_language_physics_consistency", "label": "Principle 05 \u2014 Physics is Consistent", "file_type": "rationale", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toda la experiencia comparte un unico motor de fisica; masa, inercia y desaceleracion son uniformes entre elementos del mismo tipo."}, {"id": "docs_02_spatial_design_language_camera_tells_story", "label": "Principle 06 \u2014 The Camera Tells the Story", "file_type": "rationale", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los componentes no cuentan la historia, la camara si. El guion de camara se escribe antes de construir cualquier componente."}, {"id": "docs_02_spatial_design_language_invisible_transitions", "label": "Principle 07 \u2014 Invisible Transitions", "file_type": "rationale", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El usuario nunca percibe una transicion, solo progreso; no hay estados de carga entre secciones."}, {"id": "docs_02_spatial_design_language_motion_budget", "label": "Motion Budget (max concurrent animations)", "file_type": "concept", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_spatial_design_language_motion_hierarchy", "label": "Motion Hierarchy (Narrative/Interface/Environmental)", "file_type": "concept", "source_file": "docs/02-spatial-design-language.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_02_spatial_design_language_physics_consistency", "target": "docs_03_motion_system_easing_curves", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/02-spatial-design-language.md", "source_location": null, "weight": 1.0}, {"source": "docs_02_spatial_design_language_