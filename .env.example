# NextAuth
# Genera AUTH_SECRET con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=https://extron.dev

# Admin credentials
ADMIN_EMAIL=admin@extron.dev
# Genera el hash con: npx tsx scripts/hash-password.ts
ADMIN_PASSWORD_HASH=
# DEPRECADO: usa ADMIN_PASSWORD_HASH en su lugar
# ADMIN_PASSWORD=

# Resend (email de contacto)
RESEND_API_KEY=
EMAIL_FROM=EX·TRON <onboarding@resend.dev>
CONTACT_TO=contacto@extron.dev

# Sanity CMS (blog)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
REVALIDATE_TOKEN=
