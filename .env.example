# ─────────────────────────────────────────────────────────────────────────────
# EXTRO — variables de entorno
#
# Copia este archivo a .env.local y rellena lo que necesites.
# lib/env.ts valida todo esto al arrancar: en producción el proceso falla
# ruidosamente si falta algo obligatorio, en vez de aceptar formularios y
# descartar los leads en silencio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Correo ──────────────────────────────────────────────────── OBLIGATORIO ──
# Sin esto en producción, el arranque falla a propósito.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="EXTRO <hola@extro.com.co>"
CONTACT_TO=hola@extro.com.co

# Solo desarrollo: registra los correos en el log en vez de enviarlos.
# En producción, MAIL_DRY_RUN=1 hace fallar el arranque.
MAIL_DRY_RUN=0


# ── Google Calendar + Meet ──────────────────────────────────────── OPCIONAL ──
# Sin esto la reserva sigue funcionando, pero sin disponibilidad real y sin
# enlace de Meet automático. Dos modos; configura UNO.
#
# ── Modo A · Google Workspace (recomendado) ──
# Es el ÚNICO modo que genera salas de Meet: Meet exige un usuario real como
# organizador, así que la service account lo suplanta.
#
#   1. console.cloud.google.com → habilita "Google Calendar API"
#   2. IAM y administración → Cuentas de servicio → crear (sin rol de IAM)
#   3. Pestaña Claves → Crear clave nueva → JSON → descargar
#   4. Pestaña Detalles → copiar el "ID único" (21 dígitos)
#   5. admin.google.com → Seguridad → Control de datos y acceso →
#      Controles de API → Gestionar delegación de todo el dominio → Añadir nueva
#        · ID de cliente: el número del paso 4
#        · Ámbitos (exactos, separados por coma):
#          https://www.googleapis.com/auth/calendar.events,https://www.googleapis.com/auth/calendar.readonly
#   6. Rellena las cuatro variables de abajo
#
# La delegación tarda de minutos a 24 h en propagarse. Un `unauthorized_client`
# recién configurado casi siempre es eso, no un error de credenciales.

GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=extro-booking@tu-proyecto.iam.gserviceaccount.com
# Entre comillas dobles y con los \n literales, tal como vienen en el JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# Usuario REAL de tu Workspace, no la service account. Es quien organiza la
# reunión y de quien cuelga la sala de Meet. Sin esto no hay enlace de Meet.
GOOGLE_IMPERSONATE_EMAIL=hola@extro.com.co

# ── Modo B · Cuenta de Gmail normal (sin Workspace) ──
# OAuth2 con refresh token obtenido una vez con el flujo de consentimiento.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

BOOKING_TIMEZONE=America/Bogota


# ── Escasez simulada en el calendario ───────────────────────────── OPCIONAL ──
# Proporción de huecos libres que se muestran como ocupados para transmitir
# demanda. 0 lo desactiva por completo. Máximo efectivo 0.6.
#
# Las reservas reales siempre tienen prioridad y nunca quedan menos de 6 huecos
# libres por día (features/booking/availability.ts). Un cliente que llegue con
# una hora oculta por esta capa SÍ puede reservarla: no se pierde un cliente
# real por un adorno.
NEXT_PUBLIC_FOMO_SLOTS=0.25


# ── Rate limiting ───────────────────────────────────────────────── OPCIONAL ──
# Sin esto el límite es por instancia: acota una ráfaga dentro de una misma
# lambda caliente, no un ataque distribuido. Se avisa en el log al arrancar.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ── Observabilidad ──────────────────────────────────────────────── OPCIONAL ──
# SENTRY_DSN=
LOG_LEVEL=info


# ── CMS ─────────────────────────────────────────────────────────── OPCIONAL ──
# Sin esto el blog usa el contenido local de lib/blog-posts.ts.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# Mínimo 24 caracteres. Cabecera x-sanity-secret del webhook de revalidación.
# REVALIDATE_TOKEN=


# ── Varios ──────────────────────────────────────────────────────── OPCIONAL ──
SITE_URL=https://extro.com.co
NEXT_PUBLIC_WHATSAPP_NUMBER=573005865312
